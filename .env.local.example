# Sanity CMS
# Get these from sanity.io/manage → your project → Settings → API
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
# Write token — only needed to run scripts/seed-sanity.mjs (never exposed to browser)
SANITY_API_TOKEN=your_write_token_here

# Resend (email delivery for contact form)
# Get from resend.com → API Keys
RESEND_API_KEY=re_your_key_here
CONTACT_EMAIL=geral@habilux.pt

# Site URL (used in sitemap and og:image)
# Set to custom domain when live
NEXT_PUBLIC_BASE_URL=https://habilux.vercel.app
